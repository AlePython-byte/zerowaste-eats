<?xml version="1.0" encoding="utf-8"?>
<!--
   Rules for cloud backup and device-to-device transfer on Android 12+.
   Everything is included by default; only what is listed here is left out.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Who is signed in, and their tokens, belong to this device: a restored copy must not log anyone in -->
        <exclude domain="sharedpref" path="session_prefs.xml" />
        <exclude domain="sharedpref" path="auth_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session_prefs.xml" />
        <exclude domain="sharedpref" path="auth_tokens.xml" />
    </device-transfer>
</data-extraction-rules>
