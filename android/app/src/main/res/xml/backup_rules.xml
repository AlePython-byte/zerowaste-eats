<?xml version="1.0" encoding="utf-8"?>
<!--
   Rules for Auto Backup on Android 11 and below (Android 12+ uses data_extraction_rules.xml).
   Everything is backed up by default; only what is listed here is left out.
-->
<full-backup-content>
    <!-- Who is signed in belongs to this device: a restored copy must not log anyone in -->
    <exclude domain="sharedpref" path="session_prefs.xml" />
</full-backup-content>
